# ============================================================================
# Commercial Ops Dashboard — environment variables
# ----------------------------------------------------------------------------
# Copy this file to .env.local and paste in any keys you have.
# THE APP RUNS FULLY WITH EVERY VALUE BLANK — it uses realistic mock data and
# free no-key RSS feeds as fallbacks, and badges that data as "Demo data".
# Add real keys to unlock live data; the demo badges then disappear.
# ============================================================================

# Brent crude oil prices — EIA Open Data (free, instant key by email)
# Register: https://www.eia.gov/opendata/register.php
# Used by: /api/prices  (series RBRTE — Europe Brent spot, FOB)
EIA_API_KEY=

# Vessel tracking — AISStream.io (free real-time AIS WebSocket stream)
# Sign up + create a key: https://aisstream.io
# Used by: /api/vessels  (server connects to the WS stream for a short window)
# Note: community-receiver coverage is partial; open-ocean vessels may not appear.
AISSTREAM_API_KEY=

# Oil & gas news — NewsAPI (free developer tier, 100 requests/day)
# Register: https://newsapi.org/register
# Used by: /api/news  (oil / gas / OPEC / LNG / crude headlines)
# Optional: the news feed also pulls free OilPrice.com and EIA RSS feeds,
# which need no key, so leaving this blank still gives you real headlines.
NEWSAPI_KEY=
